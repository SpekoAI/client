{
  "name": "@spekoai/client",
  "version": "0.0.11",
  "description": "Browser SDK for SpekoAI — real-time voice conversations",
  "license": "MIT",
  "author": "Speko",
  "homepage": "https://github.com/SpekoAI/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpekoAI/client.git"
  },
  "bugs": {
    "url": "https://github.com/SpekoAI/client/issues"
  },
  "keywords": [
    "speko",
    "spekoai",
    "voice-ai",
